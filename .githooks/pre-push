#!/bin/sh
# 推送前做一次全量确认；代码指纹未变时复用上次结果（约 6 秒），变了才全量。
# 紧急情况可用 git push --no-verify 绕过，并应在 PR 说明原因。
set -e
cd "$(git rev-parse --show-toplevel)"

branch=$(git branch --show-current)
if [ "$branch" = "main" ]; then
  echo "警告：正在直接推送 main；仓库约定 feature 分支 + PR（见 docs/ops/branch-protection.md）。" >&2
fi

echo "== pre-push：全量验证（代码未变时复用）=="
./scripts/verify.sh --reuse
