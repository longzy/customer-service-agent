#!/bin/sh
# 校验提交信息符合 Conventional Commits，scope 用任务号或模块名。
# 允许 merge / revert / fixup / squash 提交跳过。
set -e
message=$(head -1 "$1")

case "$message" in
  Merge* | Revert* | fixup!* | squash!* | "chore(release):"*)
    exit 0
    ;;
esac

if printf '%s' "$message" | grep -qE '^(feat|fix|docs|refactor|test|chore|perf|build|ci)(\([A-Za-z0-9._/-]+\))?: .{2,}'; then
  exit 0
fi

cat >&2 <<'EOF'
提交信息不符合 Conventional Commits：
  type(scope): 描述
  type 只能是 feat/fix/docs/refactor/test/chore/perf/build/ci
  例：feat(T-11): 回复结果校验
如确需绕过，使用 git commit --no-verify 并说明原因。
EOF
exit 1
