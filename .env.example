# 复制为 .env 后按需修改；不得提交真实密钥
# 测试账号登录只在 development/test 下启用；默认 production 会关闭
ENVIRONMENT=development
# 模型：留空则开发环境使用假模型；生产环境必须配置
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=
DATABASE_URL=postgresql+asyncpg://ba@127.0.0.1:5432/customer_service
CONFIRM_TIMEOUT_MINUTES=30
OMS_TIMEOUT_SECONDS=2
# 生产环境必须配置；development/test 留空时使用 Mock
OMS_BASE_URL=
MAX_RETRIES=3

# Cookie 是否带 Secure；不设置按环境推导（非 development/test 时为 true）
# COOKIE_SECURE=true
# 额外允许的跨站写请求来源，逗号分隔；开发/测试默认允许 localhost:3000/3001
# 经反向代理部署时必须填前端公网地址，例如 https://crm.example.com
# ALLOWED_ORIGINS=

# M1 新路由总开关与租户；回滚时 M1_ENABLED=false
M1_ENABLED=true
M1_TENANT_ID=tenant-a
# 演示账号（客户 customer_a/customer_b、坐席 agent_1/agent_2）的密码；不得提交真实密码
DEMO_PASSWORD=
# 仅 development/test 生效的假模型行为：none / error / timeout
# FAKE_MODEL_MODE=none
# 客户聊天模型超时秒数；默认 10
# CUSTOMER_MODEL_TIMEOUT_SECONDS=10

# 连接池（可选；默认见 backend/platform/settings.py）
# 每 worker 上限 = DB_POOL_SIZE + DB_MAX_OVERFLOW + TRACE_POOL_SIZE + TRACE_MAX_OVERFLOW
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# Trace 独立小池：池满按 TRACE_POOL_TIMEOUT 快速失败
# TRACE_POOL_SIZE=2
# TRACE_MAX_OVERFLOW=2
# TRACE_POOL_TIMEOUT=2
