# 复制为 .env 后按需修改；不得提交真实密钥
# 测试账号登录只在 development/test 下启用；默认 production 会关闭
ENVIRONMENT=development
# 模型：留空则开发环境使用假模型；生产环境必须配置
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=
DATABASE_URL=postgresql+asyncpg://ba@127.0.0.1:5432/customer_service
CONFIRM_TIMEOUT_MINUTES=30
OMS_TIMEOUT_SECONDS=2
MAX_RETRIES=3
