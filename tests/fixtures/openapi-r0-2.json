{
  "components": {
    "schemas": {
      "CancelResultPayload": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "state": {
            "enum": [
              "ACCEPTED",
              "CANCELLED",
              "REJECTED",
              "UNKNOWN"
            ],
            "title": "State",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "idempotency_key",
          "state"
        ],
        "title": "CancelResultPayload",
        "type": "object"
      },
      "CustomerLoginRequest": {
        "additionalProperties": false,
        "description": "只接受用户名/密码；租户与客户 id 只能来自服务端配置与 session。",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "CustomerLoginRequest",
        "type": "object"
      },
      "CustomerMessageRequest": {
        "additionalProperties": false,
        "description": "客户消息；身份与会话只能来自服务端 session。",
        "properties": {
          "content": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "CustomerMessageRequest",
        "type": "object"
      },
      "FaultPayload": {
        "additionalProperties": false,
        "properties": {
          "delay_ms": {
            "default": 0,
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "timeout",
              "lost_response",
              "invalid_response",
              "unavailable",
              "delay"
            ],
            "title": "Kind",
            "type": "string"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "times": {
            "default": 1,
            "minimum": 1.0,
            "title": "Times",
            "type": "integer"
          },
          "tool": {
            "anyOf": [
              {
                "enum": [
                  "get_order",
                  "list_recent_orders",
                  "get_cancel_eligibility",
                  "submit_cancel",
                  "get_cancel_result"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          }
        },
        "required": [
          "kind"
        ],
        "title": "FaultPayload",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HandoffPayload": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "title": "HandoffPayload",
        "type": "object"
      },
      "MessageRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "required": [
          "content"
        ],
        "title": "MessageRequest",
        "type": "object"
      },
      "RequestPayload": {
        "additionalProperties": false,
        "properties": {
          "order_id": {
            "title": "Order Id",
            "type": "string"
          }
        },
        "required": [
          "order_id"
        ],
        "title": "RequestPayload",
        "type": "object"
      },
      "SessionRequest": {
        "additionalProperties": false,
        "description": "只接受 account_id；租户与用户不得由请求体提供。",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
