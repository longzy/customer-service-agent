{
  "openapi": "3.1.0",
  "info": {
    "title": "M1 Tool 契约",
    "version": "0.1.0"
  },
  "paths": {
    "/tools/list_recent_orders": {
      "post": {
        "operationId": "list_recent_orders",
        "summary": "调用 list_recent_orders",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRecentOrdersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListRecentOrdersResponse"
                }
              }
            }
          },
          "default": {
            "description": "统一错误封套",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "DEPENDENCY_UNAVAILABLE",
          "DEPENDENCY_TIMEOUT",
          "INVALID_RESPONSE"
        ]
      }
    },
    "/tools/get_order": {
      "post": {
        "operationId": "get_order",
        "summary": "调用 get_order",
        "requestBody": {
          "required": true,
